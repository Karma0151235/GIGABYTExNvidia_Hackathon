# Free, fully local semantic inference. No API key or paid service is used.
SIGNAL_FUSION_EMBEDDING_PROVIDER=local
SIGNAL_FUSION_LOCAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local PostgreSQL service from the root docker-compose.yml.
DATABASE_URL=postgresql://anwar:anwar_local_dev@127.0.0.1:5432/anwar

# Local OSRM built from malaysia-singapore-brunei-260712.osm.pbf.
OSRM_BASE_URL=http://127.0.0.1:5000
DGX_STT_BASE_URL=http://192.168.0.108:9001/v1
DGX_STT_MODEL=omni
DGX_TRIAGE_BASE_URL=http://192.168.0.108:9000/v1
DGX_TRIAGE_MODEL=lightning
ANWAR_CALL_AUDIO_DIR=./data/call-audio

# Dispatch Copilot narrative layer. Visual rows come from fixed ANWAR queries.
DGX_COPILOT_BASE_URL=http://192.168.0.108:9000/v1
DGX_COPILOT_MODEL=lightning

# First-responder image report drafts on the DGX Spark Omni VLM.
# Use http://127.0.0.1:9001/v1 when port 9001 is forwarded over SSH.
DGX_VLM_BASE_URL=http://192.168.0.108:9001/v1
DGX_VLM_MODEL=omni
DGX_VLM_TIMEOUT_SECONDS=90
DGX_VLM_MAX_TOKENS=4096
